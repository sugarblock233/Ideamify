# 本机单用户：打开即可进入项目管理页，无需账号或令牌。
RESEARCHMAP_AUTH_MODE=local
RESEARCHMAP_PORT=8000

# 可选：为 AI / CLI 配置具名令牌以区分提交身份；不配置时本机身份为 researcher。
# 远程部署时须显式改为 RESEARCHMAP_AUTH_MODE=token，并配置长随机令牌。
# RESEARCHMAP_TOKENS={"researcher":"replace-with-a-long-random-value","ai-one":"replace-with-another-long-random-value"}

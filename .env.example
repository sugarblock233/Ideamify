# ResearchMap 部署变量（复制为 .env 后修改；.env 不入库）
#
# 令牌：内联 JSON，"名字" 会成为提交记录里的 actor 身份，
# 令牌字符串必须 ≥12 个字符且不同名不同值。例子里给一个研究者
# 令牌与一个 AI 终端令牌（AI 会话另开 terminal 用 CLI 时用）。
RESEARCHMAP_TOKENS={"researcher":"换成-researcher-的强令牌","ai-one":"换成-ai-one-的强令牌"}

# 容器对外端口（本地访问 http://localhost:8000/）
RESEARCHMAP_PORT=8000